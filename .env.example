# Application user: SELECT, INSERT, UPDATE, DELETE on this database only.
DATABASE_URL=mysql://agency_app:replace-with-a-strong-password@127.0.0.1:3306/agency
# Used only by explicit migration commands; never NEXT_PUBLIC.
DATABASE_ADMIN_URL=mysql://migration_user:replace-with-a-strong-password@127.0.0.1:3306/agency
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_BOOKING_URL=/contact
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Set HTTPS BETTER_AUTH_URL in production for Secure cookies.
MEDIA_DIRECTORY=./storage/media
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# First administrator is created by CLI only. Supply these as temporary process env vars.
# ADMIN_EMAIL=your-real-email
# ADMIN_NAME=Your name
# ADMIN_PASSWORD=your-generated-password-with-at-least-12-characters

# Exact comma-separated SMTP provider hostnames permitted by the server operator.
# Private/reserved addresses are rejected even when allowlisted.
SMTP_ALLOWED_HOSTS=
# Keep this stable and backed up. Generate a random secret of at least 32 characters.
# Existing installations can use BETTER_AUTH_SECRET as the fallback encryption key.
SMTP_ENCRYPTION_KEY=
# Database-backed delivery: schedule `npm run email:worker` at least once per minute.
# The worker sends pending jobs only. Definitively rejected jobs are retried explicitly.

# Private paid files: durable storage outside public/; never serve this directory directly.
STORE_FILE_DIRECTORY=./storage/store-private
# Commerce payments remain disabled until the Stripe integration is completed and verified.
# Prefer a restricted test/sandbox key with only the required permissions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
